{
  "openapi": "3.0.3",
  "info": {
    "title": "FlavorBuddy owned-app catalog API",
    "version": "1.0.0",
    "description": "App-only approved starter reads. Existing public starter content remains public. No private data, user impersonation, writes or AI. Breaking changes require a new path version; announce retirement at least 90 days before disabling v1. Reads need no idempotency key. Rotation/revocation invalidate tokens immediately; already downloaded content cannot be recalled."
  },
  "servers": [
    {
      "url": "/api/integrations/v1"
    }
  ],
  "security": [
    {
      "catalogOAuth": [
        "catalog:read"
      ]
    }
  ],
