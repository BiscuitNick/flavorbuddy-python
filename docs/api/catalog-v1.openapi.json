    "/oauth/token": {
      "post": {
        "security": [
          {
            "clientBasic": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "grant_type",
                  "resource"
                ],
                "properties": {
                  "grant_type": {
                    "type": "string",
                    "enum": [
                      "client_credentials"
                    ]
                  },
                  "scope": {
                    "type": "string",
                    "enum": [
                      "catalog:read"
                    ]
                  },
                  "resource": {
                    "type": "string",
                    "format": "uri",
                    "description": "Exact PROJECT_URL + /api/integrations/v1/ audience; required."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Opaque Bearer access_token, token_type, scope and expires_in=300; no refresh token.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "access_token": {
                      "type": "string"
                    },
                    "expires_in": {
                      "type": "integer",
                      "enum": [
                        300
                      ]
                    },
                    "token_type": {
                      "type": "string"
                    },
                    "scope": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Standard OAuth error object: error and optional error_description."
          },
          "401": {
            "description": "Invalid client credentials or disabled registration."
          },
          "429": {
            "description": "Token issuance quota exhausted; Retry-After: 60."
          }
        }
      }
    },
    "/oauth/revoke": {
      "post": {
        "security": [
          {
            "clientBasic": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "token"
                ],
                "properties": {
                  "token": {
                    "type": "string"
                  },
                  "token_type_hint": {
                    "type": "string",
                    "enum": [
                      "access_token"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token revoked or already absent."
          },
          "400": {
            "description": "Standard OAuth error object: error and optional error_description."
          },
          "401": {
            "description": "Invalid client credentials or disabled registration."
          },
          "429": {
            "description": "Token issuance quota exhausted; Retry-After: 60."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "catalogOAuth": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "/api/integrations/v1/oauth/token",
            "scopes": {
              "catalog:read": "Read explicitly granted catalog content"
            }
          }
        }
      },
      "clientBasic": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "schemas": {
      "Recipe": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "title",
          "provenance",
          "ingredients",
          "instructions"
        ],
        "properties": {
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "source_url": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "yields": {
            "type": "string"
          },
          "id": {
            "type": "integer"
          },
          "total_time": {
            "type": "integer",
            "nullable": true
          },
          "ingredients": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "instructions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "provenance": {
            "type": "object",
            "description": "Source URL, license, license URL, repository and source revision; retain with exported content.",
            "additionalProperties": true
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "fields",
              "request_id"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "fields": {
                "type": "object",
                "additionalProperties": true
              },
              "request_id": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        }
      }
    }
  }
}
