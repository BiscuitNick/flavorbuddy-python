                  {
                    "type": "null"
                  }
                ]
              },
              "repository_url": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https?://"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "repository_revision": {
                "anyOf": [
                  {
                    "type": "string",
