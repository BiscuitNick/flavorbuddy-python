{
  "openapi": "3.1.0",
  "info": {
    "title": "FlavorBuddy owned-app catalog API",
    "version": "2.0.0",
    "description": "Read-only search and immutable UUID documents. Obtain catalog:read tokens through /api/integrations/v1/oauth/token with resource set to the exact /api/integrations/v2/ origin/path. V1 tokens cannot access v2 and vice versa. Both versions share grants, revocation and quotas. Unknown/repeated parameters are rejected. No voting, generation, quantity inference or editorial approval."
  },
  "servers": [
    {
      "url": "https://flavorbuddy-staging-560489769953.us-central1.run.app/api/integrations/v2"
    }
  ],
  "security": [
    {
      "catalogToken": []
    }
  ],
  "paths": {
    "/catalogs/{catalog}/recipes": {
      "get": {
        "operationId": "searchCatalog",
        "description": "Literal phrase search across title, description and ingredient source text. Relevance: exact title, title match, description match, ingredient match; ties newest then ID. Quickest: known times ascending then ID; unknown times last. Signed keyset cursors expire after one hour and are bound to app, catalog, all parameters and search start; grants/visibility are rechecked on each page.",
        "parameters": [
          {
            "name": "catalog",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "newest",
                "quickest"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 24
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 4096
            }
          },
          {
            "name": "max_total_minutes",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "results",
                    "next_cursor"
                  ],
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "recipe_id",
                          "title",
                          "description",
                          "image_url",
                          "yield_text",
                          "total_minutes",
                          "feedback"
                        ],
                        "properties": {
                          "recipe_id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "title": {
                            "type": "string"
                          },
                          "description": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "image_url": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "yield_text": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "total_minutes": {
                            "type": [
                              "integer",
                              "null"
                            ],
                            "minimum": 0
                          },
                          "feedback": {
                            "type": "null",
                            "description": "Feedback is not implemented; null is not a zero-vote claim."
                          }
                        }
                      }
                    },
                    "next_cursor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid/unsupported parameters or cursor"
          },
          "401": {
            "description": "Invalid/expired/revoked app token"
          },
          "403": {
            "description": "Missing catalog:read scope"
          },
          "404": {
            "description": "Unknown or ungranted catalog/recipe"
          },
          "429": {
            "description": "Shared app/global quota exceeded"
          },
          "503": {
            "description": "Stored recipe cannot be represented by the document contract"
          }
        }
      }
    },
    "/recipes/{recipe_id}": {
      "get": {
        "operationId": "getRecipeDocument",
        "description": "Granted finalized identity only. Private/archived granted identity returns 410 with no content; unknown or ungranted identity returns 404. Stable ingredient/step IDs are scoped to the recipe UUID. Refresh availability before each cooking session.",
        "parameters": [
          {
            "name": "recipe_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Immutable document and current status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "document",
                    "status"
                  ],
                  "properties": {
                    "document": {
                      "$ref": "#/components/schemas/RecipeDocumentV1"
                    },
                    "status": {
                      "type": "object",
                      "required": [
                        "recipe_id",
                        "availability",
                        "feedback"
                      ],
                      "properties": {
                        "recipe_id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "availability": {
                          "enum": [
                            "available",
                            "unavailable"
                          ]
                        },
                        "feedback": {
                          "type": "null"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "410": {
            "description": "Unavailable; never substitute content",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "document",
                    "status"
                  ],
                  "properties": {
                    "document": {
                      "type": "null"
                    },
                    "status": {
                      "type": "object",
                      "required": [
                        "recipe_id",
                        "availability",
                        "feedback"
                      ],
                      "properties": {
                        "recipe_id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "availability": {
                          "enum": [
                            "available",
                            "unavailable"
                          ]
                        },
                        "feedback": {
                          "type": "null"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid/unsupported parameters or cursor"
          },
          "401": {
            "description": "Invalid/expired/revoked app token"
          },
          "403": {
            "description": "Missing catalog:read scope"
          },
          "404": {
            "description": "Unknown or ungranted catalog/recipe"
          },
          "429": {
            "description": "Shared app/global quota exceeded"
          },
          "503": {
            "description": "Stored recipe cannot be represented by the document contract"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "catalogToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Opaque OAuth client-credentials token; catalog:read required."
      }
    },
    "schemas": {
      "RecipeDocumentV1": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://flavorbuddy-staging-560489769953.us-central1.run.app/api/integrations/v2/recipe-document.schema.json",
        "title": "RecipeDocumentV1",
        "description": "Immutable recipe content. Null means unknown/unassessed; empty arrays mean an explicitly assessed absence. Publication, validation results, thumbs feedback and report-driven availability are separate server records. This schema cannot prove culinary correctness, immutable storage or referential integrity.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "recipe_id",
          "finalized_at",
          "title",
          "description",
          "language",
          "yield",
          "provenance",
          "ingredient_groups",
          "ingredients",
          "step_groups",
          "steps",
          "equipment",
          "timing",
          "images",
          "tags"
        ],
        "properties": {
          "schema_version": {
            "const": "1.0.0"
          },
          "recipe_id": {
            "type": "string",
            "format": "uuid"
          },
          "finalized_at": {
            "type": "string",
            "format": "date-time"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "\\S"
          },
          "description": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "language": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "yield": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "original_text",
              "quantity",
              "unit"
            ],
            "properties": {
              "original_text": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255,
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "quantity": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Quantity"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "unit": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "origin",
              "sources",
              "inspired_by_recipe_id",
              "original_notes"
            ],
            "properties": {
              "origin": {
                "enum": [
                  "imported",
                  "manual",
                  "ai_generated",
                  "derived"
                ]
              },
              "sources": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Source"
                },
                "minItems": 0,
                "maxItems": 20
              },
              "inspired_by_recipe_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uuid"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "original_notes": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 10000,
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "ingredient_groups": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Group"
                },
                "minItems": 0,
                "maxItems": 100
              },
              {
                "type": "null"
              }
            ]
          },
          "ingredients": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Ingredient"
            },
            "minItems": 1,
            "maxItems": 200
          },
          "step_groups": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Group"
                },
                "minItems": 0,
                "maxItems": 100
              },
              {
                "type": "null"
              }
            ]
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Step"
            },
            "minItems": 1,
            "maxItems": 400
          },
          "equipment": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Equipment"
                },
                "minItems": 0,
                "maxItems": 100
              },
              {
                "type": "null"
              }
            ]
          },
          "timing": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "original_text",
              "prep",
              "cook",
              "rest",
              "total"
            ],
            "properties": {
              "original_text": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000,
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "prep": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Duration"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "cook": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Duration"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "rest": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Duration"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "total": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Duration"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "images": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Image"
                },
                "minItems": 0,
                "maxItems": 25
              },
              {
                "type": "null"
              }
            ]
          },
          "tags": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Tag"
                },
                "maxItems": 30,
                "uniqueItems": true
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "$defs": {
          "Quantity": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "value"
                ],
                "properties": {
                  "kind": {
                    "const": "exact"
                  },
                  "value": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "minimum",
                  "maximum"
                ],
                "properties": {
                  "kind": {
                    "const": "range"
                  },
                  "minimum": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                  },
                  "maximum": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                  }
                }
              }
            ]
          },
          "Unit": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "original_text",
              "code"
            ],
            "properties": {
              "original_text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "\\S"
              },
              "code": {
                "anyOf": [
                  {
                    "enum": [
                      "g",
                      "kg",
                      "mg",
                      "mL",
                      "L",
                      "oz_mass",
                      "lb_mass",
                      "tsp_us",
                      "tbsp_us",
                      "cup_us",
                      "tsp_metric",
                      "tbsp_metric",
                      "cup_metric",
                      "cup_imperial",
                      "count"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "Duration": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "minimum_seconds",
              "maximum_seconds",
              "original_text",
              "basis"
            ],
            "properties": {
              "minimum_seconds": {
                "type": "integer",
                "minimum": 0,
                "maximum": 31536000
              },
              "maximum_seconds": {
                "type": "integer",
                "minimum": 0,
                "maximum": 31536000
              },
              "original_text": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500,
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "basis": {
                "enum": [
                  "source_explicit",
                  "editor_authored"
                ]
              }
            }
          },
          "Group": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^grp-[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "\\S"
              }
            }
          },
          "SourceRef": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_id",
              "locator"
            ],
            "properties": {
              "source_id": {
                "type": "string",
                "pattern": "^src-[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              "locator": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000,
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "Ingredient": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "original_text",
              "name",
              "quantity",
              "unit",
              "preparation",
              "group_id",
              "optional",
              "source_refs"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^ing-[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              "original_text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "pattern": "\\S"
              },
              "name": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200,
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "quantity": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Quantity"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "unit": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Unit"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "preparation": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000,
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "group_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^grp-[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "optional": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "source_refs": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/SourceRef"
                },
                "minItems": 0,
                "maxItems": 20
              }
            }
          },
          "Equipment": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "original_text",
              "specification",
              "source_refs"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^eq-[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "\\S"
              },
              "original_text": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000,
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "specification": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000,
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "source_refs": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/SourceRef"
                },
                "minItems": 0,
                "maxItems": 20
              }
            }
          },
          "IngredientRef": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ingredient_id",
              "portion_quantity",
              "portion_unit",
              "original_text"
            ],
            "properties": {
              "ingredient_id": {
                "type": "string",
                "pattern": "^ing-[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              "portion_quantity": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Quantity"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "portion_unit": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Unit"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "original_text": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000,
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "Timer": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "duration",
              "start_mode",
              "completion_condition"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^timer-[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "\\S"
              },
              "duration": {
                "$ref": "#/$defs/Duration"
              },
              "start_mode": {
                "const": "user_confirmation"
              },
              "completion_condition": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000,
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "Step": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "position",
              "original_text",
              "instruction",
              "group_id",
              "ingredient_refs",
              "unresolved_ingredient_text",
              "equipment_refs",
              "unresolved_equipment_text",
              "timers",
              "source_refs"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^step-[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              "position": {
                "type": "integer",
                "minimum": 1,
                "maximum": 400
              },
              "original_text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000,
