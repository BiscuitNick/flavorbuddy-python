{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flavorbuddy.example/schemas/recipe-document/1.0.0",
  "title": "RecipeDocumentV1 \u2014 audit proposal only",
  "description": "Immutable recipe content. Null means unknown/unassessed; empty arrays mean an explicitly assessed absence. Publication, validation results, thumbs feedback and report-driven availability are separate server records. This schema cannot prove culinary correctness, immutable storage or referential integrity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "recipe_id",
    "finalized_at",
    "title",
    "description",
    "language",
    "yield",
    "provenance",
    "ingredient_groups",
    "ingredients",
    "step_groups",
    "steps",
    "equipment",
    "timing",
    "images",
    "tags"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "recipe_id": {
      "type": "string",
      "format": "uuid"
    },
    "finalized_at": {
      "type": "string",
      "format": "date-time"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "\\S"
    },
    "description": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "language": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "yield": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "original_text",
        "quantity",
        "unit"
      ],
      "properties": {
        "original_text": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "quantity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "sources",
        "inspired_by_recipe_id",
        "original_notes"
      ],
      "properties": {
        "origin": {
          "enum": [
            "imported",
            "manual",
            "ai_generated",
            "derived"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Source"
          },
          "minItems": 0,
          "maxItems": 20
        },
        "inspired_by_recipe_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "original_notes": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 10000,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ingredient_groups": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Group"
          },
          "minItems": 0,
          "maxItems": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "ingredients": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Ingredient"
      },
      "minItems": 1,
      "maxItems": 200
    },
    "step_groups": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Group"
          },
          "minItems": 0,
          "maxItems": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Step"
      },
      "minItems": 1,
      "maxItems": 400
    },
    "equipment": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Equipment"
          },
          "minItems": 0,
          "maxItems": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "original_text",
        "prep",
        "cook",
        "rest",
        "total"
      ],
      "properties": {
        "original_text": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "prep": {
          "anyOf": [
            {
              "$ref": "#/$defs/Duration"
            },
            {
              "type": "null"
            }
          ]
        },
        "cook": {
          "anyOf": [
            {
              "$ref": "#/$defs/Duration"
            },
            {
              "type": "null"
            }
          ]
        },
        "rest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Duration"
            },
            {
              "type": "null"
            }
          ]
        },
        "total": {
          "anyOf": [
            {
              "$ref": "#/$defs/Duration"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "images": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Image"
          },
          "minItems": 0,
          "maxItems": 25
        },
        {
          "type": "null"
        }
      ]
    },
    "tags": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Tag"
          },
          "maxItems": 30,
          "uniqueItems": true
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "Quantity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "exact"
            },
            "value": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "minimum",
            "maximum"
          ],
          "properties": {
            "kind": {
              "const": "range"
            },
            "minimum": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            },
            "maximum": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            }
          }
        }
      ]
    },
    "Unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "original_text",
        "code"
      ],
      "properties": {
        "original_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "\\S"
        },
        "code": {
          "anyOf": [
            {
              "enum": [
                "g",
                "kg",
                "mg",
                "mL",
                "L",
                "oz_mass",
                "lb_mass",
                "tsp_us",
                "tbsp_us",
                "cup_us",
                "tsp_metric",
                "tbsp_metric",
                "cup_metric",
                "cup_imperial",
                "count"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Duration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_seconds",
        "maximum_seconds",
        "original_text",
        "basis"
      ],
      "properties": {
        "minimum_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31536000
        },
        "maximum_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31536000
        },
        "original_text": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "basis": {
          "enum": [
            "source_explicit",
            "editor_authored"
          ]
        }
      }
    },
    "Group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^grp-[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        }
      }
    },
    "SourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "locator"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^src-[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "locator": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Ingredient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "original_text",
        "name",
        "quantity",
        "unit",
        "preparation",
        "group_id",
        "optional",
        "source_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ing-[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "original_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "name": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "quantity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "anyOf": [
            {
              "$ref": "#/$defs/Unit"
            },
            {
              "type": "null"
            }
          ]
        },
        "preparation": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "group_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^grp-[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "optional": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "minItems": 0,
          "maxItems": 20
        }
      }
    },
    "Equipment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "original_text",
        "specification",
        "source_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^eq-[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "original_text": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "specification": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "minItems": 0,
          "maxItems": 20
        }
      }
    },
    "IngredientRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ingredient_id",
        "portion_quantity",
        "portion_unit",
        "original_text"
      ],
      "properties": {
        "ingredient_id": {
          "type": "string",
          "pattern": "^ing-[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "portion_quantity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "portion_unit": {
          "anyOf": [
            {
              "$ref": "#/$defs/Unit"
            },
            {
              "type": "null"
            }
          ]
        },
        "original_text": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Timer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "duration",
        "start_mode",
        "completion_condition"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^timer-[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "duration": {
          "$ref": "#/$defs/Duration"
        },
        "start_mode": {
          "const": "user_confirmation"
        },
        "completion_condition": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "position",
        "original_text",
        "instruction",
        "group_id",
        "ingredient_refs",
        "unresolved_ingredient_text",
        "equipment_refs",
        "unresolved_equipment_text",
        "timers",
        "source_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^step-[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "position": {
          "type": "integer",
          "minimum": 1,
          "maximum": 400
        },
        "original_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000,
          "pattern": "\\S"
        },
        "instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000,
          "pattern": "\\S"
        },
        "group_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^grp-[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "ingredient_refs": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/IngredientRef"
              },
              "minItems": 0,
              "maxItems": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "unresolved_ingredient_text": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "\\S"
              },
              "minItems": 0,
              "maxItems": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "equipment_refs": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^eq-[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              "maxItems": 100,
              "uniqueItems": true
            },
            {
              "type": "null"
            }
          ]
        },
        "unresolved_equipment_text": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "\\S"
              },
              "minItems": 0,
              "maxItems": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "timers": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Timer"
              },
              "minItems": 0,
              "maxItems": 20
            },
            {
              "type": "null"
            }
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "minItems": 0,
          "maxItems": 20
        }
      }
    },
    "Source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "url",
        "author",
        "repository_url",
        "repository_revision",
        "path",
        "source_sha256",
        "license",
        "legacy_locator"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^src-[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://"
            },
            {
              "type": "null"
            }
          ]
        },
        "author": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "repository_url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://"
            },
            {
              "type": "null"
            }
          ]
        },
        "repository_revision": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "identifier",
            "url",
            "rights_basis"
          ],
          "properties": {
            "identifier": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            },
            "url": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https?://"
                },
                {
                  "type": "null"
                }
              ]
            },
            "rights_basis": {
              "enum": [
                "source_license",
                "user_assertion",
                "unknown"
              ]
            }
          }
        },
        "legacy_locator": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "asset_id",
        "sha256",
        "alt_text",
        "origin",
        "source_url",
        "license"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^img-[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "asset_id": {
          "type": "string",
          "format": "uuid"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "alt_text": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "origin": {
          "enum": [
            "source",
            "user_upload",
            "generated_illustration"
          ]
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://"
            },
            {
              "type": "null"
            }
          ]
        },
        "license": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Tag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vocabulary",
        "code"
      ],
      "properties": {
        "vocabulary": {
          "const": "flavorbuddy-tags/1"
        },
        "code": {
          "enum": [
            "course:breakfast",
            "course:lunch",
            "course:dinner",
            "course:dessert",
