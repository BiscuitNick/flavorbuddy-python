# Copy this file to .env and fill in values as needed.
# config/settings.py loads .env automatically on startup.

# Postgres connection (matches the defaults in docker-compose.yml)
POSTGRES_DB=flavorbuddy
POSTGRES_USER=flavorbuddy
POSTGRES_PASSWORD=flavorbuddy
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Base URL the app considers itself hosted at (optional)
PROJECT_URL=http://localhost:8000

# Required only for the /convert-raw-recipe AI endpoint (Replicate API token)
REPLICATE_API_TOKEN=

DJANGO_ENV=development
DJANGO_DEBUG=true
# Production requires a unique random 50+ character value and explicit hosts.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
TRUST_PROXY_HTTPS=false
AI_ENABLED=false
AI_USER_DAILY_LIMIT=0
AI_GLOBAL_DAILY_LIMIT=0
# Configure SMTP before offering email password recovery in deployment.
EMAIL_BACKEND=django.core.mail.backends.locmem.EmailBackend
# For a managed database, configure its required TLS mode or private connector.
POSTGRES_SSLMODE=prefer
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@localhost

# Licensed public starter images. Use gcs in deployment, local for development.
STARTER_IMAGE_STORAGE=local
GS_STARTER_BUCKET_NAME=
# Use Application Default Credentials / attached service identity for GCS.

# Server-to-server catalog API (independent of user session permissions).
APP_GLOBAL_DAILY_LIMIT=10000
APP_TOKEN_MINUTE_LIMIT=60
# Private uploads: separate storage. Production defaults to disabled.
PRIVATE_PHOTO_BACKEND=local
GS_PRIVATE_BUCKET_NAME=
PRIVATE_PHOTO_STORAGE_BYTES=26214400
PRIVATE_PHOTO_COUNT=25
# Fixture captures require an explicit CapabilityGrant and a separate worker.
# Only disabled/fixture exist. Fixture is rejected in production; no live AI.
CAPTURE_PROVIDER=disabled
CAPTURE_GLOBAL_DAILY_LIMIT=30
